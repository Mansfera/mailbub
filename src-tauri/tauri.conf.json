{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mailbub",
  "version": "0.1.0",
  "identifier": "com.mansfera.mailbub",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Mailbub",
        "width": 1120,
        "height": 740,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 24
        },
        "transparent": true,
        "dragDropEnabled": false,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https: http: avatar: http://avatar.localhost; style-src 'self' 'unsafe-inline' https: http:; font-src 'self' data: https: http:; media-src https: http:; frame-src 'self' https: http: mailto: tel:; object-src 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Mailbub Code Signing"
    }
  }
}
