# Homebrew cask for Mailbub. Generated by scripts/release.sh from this template;
# the result goes to the tap repository as Casks/mailbub.rb.
cask "mailbub" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/@RELEASE_REPO@/releases/download/v#{version}/Mailbub_#{version}_aarch64.dmg"
  name "Mailbub"
  desc "Email as chat: several mail accounts shown as a messenger"
  homepage "https://github.com/@RELEASE_REPO@"

  depends_on arch: :arm64
  depends_on :macos

  app "Mailbub.app"

  # Mailbub is not notarized (that needs a paid Apple Developer ID), so macOS would refuse
  # to open a quarantined download. Clearing the quarantine flag is what "Open Anyway" does.
  postflight_steps do
    run "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "{{appdir}}/Mailbub.app"]
  end

  # Account passwords and sign-in tokens live in the Keychain (service com.mansfera.mailbub);
  # remove accounts in Settings before uninstalling to delete them.
  zap trash: [
    "~/Library/Application Support/com.mansfera.mailbub",
    "~/Library/Caches/com.mansfera.mailbub",
    "~/Library/WebKit/com.mansfera.mailbub",
  ]
end
